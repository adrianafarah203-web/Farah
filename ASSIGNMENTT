/*
1. Objectives:
   - Manage book borrowing and returning processes for library members.
   - Automatically update the available book stock count.
   - Calculate overdue fines at RM 0.50 perday when a book is kept over 14 days.
   
2. Key Logic & Rules:
   - Borrowing (Type 1): Decrements stock by 1 if available. If stock is 0,
     the transaction fails.
   - Returning (Type 2): Increments stock by 1 and prompts for total days borrowed.
   - Overdue Calculation: Fines apply only if borrowed days exceed 14 days.

3. Assumptions & Constraints:
   - Inputs are valid positive numbers.
   - Transaction types are strictly restricted to 1 (Borrow) or 2 (Return).
*/


#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

double calculateFine(int daysBorrowed);
void processTransaction(int transactionType, int &bookQuantity);

int main() {
    string memberID, bookID;
    int transactionType, bookQuantity;

    cout << "Enter Member ID : ";
    cin >> memberID;
    cout << "Enter Book ID : ";
    cin >> bookID;
    cout << "Enter Available Quantity: ";
    cin >> bookQuantity;
    cout << "\nSelect Transaction Type (1 = Borrow, 2 = Return): ";
    cin >> transactionType;

    processTransaction(transactionType, bookQuantity);

    return 0;
}

void processTransaction(int transactionType, int &bookQuantity) {
    int daysBorrowed = 0;
    double fine = 0.0;

    if (transactionType == 1) { 
        if (bookQuantity > 0) {
            bookQuantity--;
            cout << "Status             : Borrowing Successful" << endl;
            cout << "Updated Quantity   : " << bookQuantity << endl;
            cout << "Overdue Fine       : RM 0.00" << endl;
        } else {
            cout << "Status             : Failed (Book Out of Stock)" << endl;
            cout << "Updated Quantity   : " << bookQuantity << endl;
        }
    } 
    else if (transactionType == 2) { 
        cout << "Enter Number of Days Borrowed: ";
        cin >> daysBorrowed;
        bookQuantity++;
        fine = calculateFine(daysBorrowed);
        cout << "\nStatus             : Return Successful" << endl;
        cout << "Updated Quantity   : " << bookQuantity << endl;

        if (fine > 0) {
            int overdueDays = daysBorrowed - 14;
            cout << "Return Condition   : OVERDUE " << overdueDays << " day" << endl;
            cout << "Overdue Fine       : RM " << fixed << setprecision(2) << fine << endl;
        } else {
            cout << "Return Condition   : On Time" << endl;
            cout << "Overdue Fine       : RM 0.00" << endl;
        }
    } 
    else {
        cout << "Invalid Transaction Type!" << endl;
    }
}

double calculateFine(int daysBorrowed) {
    const double finePerDay = 1.50; 
    const int allowedDays = 14;

    if (daysBorrowed >  allowedDays) {
        int overdueDays = daysBorrowed - allowedDays;
        return overdueDays * finePerDay;
    }
    
    return 0.0;
}
