#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

double calculateFine(int daysBorrowed);
void processTransaction(int transactionType, int &bookQuantity);

int main() {
    string memberID, bookID;
    int transactionType, bookQuantity;

    cout << "Enter Member ID : ";
    cin >> memberID;
    cout << "Enter Book ID : ";
    cin >> bookID;
    cout << "Enter Available Quantity: ";
    cin >> bookQuantity;
    cout << "\nSelect Transaction Type (1 = Borrow, 2 = Return): ";
    cin >> transactionType;

    processTransaction(transactionType, bookQuantity);

    return 0;
}

void processTransaction(int transactionType, int &bookQuantity) {
    int daysBorrowed = 0;
    double fine = 0.0;

    if (transactionType == 1) { // Borrow
        if (bookQuantity > 0) {
            bookQuantity--;
            cout << "Status             : Borrowing Successful" << endl;
            cout << "Updated Quantity   : " << bookQuantity << endl;
            cout << "Overdue Fine       : RM 0.00" << endl;
        } else {
            cout << "Status             : Failed (Book Out of Stock)" << endl;
            cout << "Updated Quantity   : " << bookQuantity << endl;
        }
    } 
    else if (transactionType == 2) { 
        cout << "Enter Number of Days Borrowed: ";
        cin >> daysBorrowed;
        bookQuantity++;
        fine = calculateFine(daysBorrowed);
        cout << "\nStatus             : Return Successful" << endl;
        cout << "Updated Quantity   : " << bookQuantity << endl;

        if (fine > 0) {
            int overdueDays = daysBorrowed - 7;
            cout << "Return Condition   : OVERDUE " << overdueDays << " day" << endl;
            cout << "Overdue Fine       : RM " << fixed << setprecision(2) << fine << endl;
        } else {
            cout << "Return Condition   : On Time" << endl;
            cout << "Overdue Fine       : RM 0.00" << endl;
        }
    } 
    else {
        cout << "Invalid Transaction Type!" << endl;
    }
}

double calculateFine(int daysBorrowed) {
    const double FINE_PER_DAY = 0.50; 
    const int ALLOWED_DAYS = 14;

    if (daysBorrowed > ALLOWED_DAYS) {
        int overdueDays = daysBorrowed - ALLOWED_DAYS;
        return overdueDays * FINE_PER_DAY;
    }
    
    return 0.0;
