#include <iostream>
#include <iomanip>
using namespace std;


int getcalculateoverduedays(int returnDate,int borrowingDate,int borrowingMonth, int returnMonth) {
	int allowedDays=14;
	int actualDays=(returnMonth-borrowingMonth)*30 +(returnDate-borrowingDate);
	int overdueDays;

	if(actualDays>allowedDays) {
		return actualDays-allowedDays;

	} else

		return 0;

}


int getborrowBook(int availableQuantity) {

	if(availableQuantity>0) {
		cout<< "Book is available for borrowing."<<endl;
		availableQuantity=availableQuantity-1;
		cout<<"Borrow Successful"<<endl;
	} else
		cout<< "Borrow Failed: Book Out of Stock"<<endl;
	return availableQuantity;

}
int getreturnBook(int availableQuantity) {
	availableQuantity=availableQuantity+1;
	cout<<"Return Successful"<<endl;
	return availableQuantity;
}

int main() {
	string memberID,BookID,transactionType;
	int borrowingDate,returnDate,availableQuantity,overdueDays,borrowingMonth,returnMonth;
	double fineperDay=1.50,overduefine=0.00;

